# ---- App ----
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=replace-with-fernet-key
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# ---- Database ----
DATABASE_URL=sqlite:///./jobmail.db
# Production: postgresql+psycopg2://user:password@localhost:5432/jobmail

# ---- Google OAuth (never commit real values) ----
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://jobmail-mq9i.onrender.com/api/auth/google/callback

# ---- Sending ----
DEFAULT_SEND_DELAY_SECONDS=10
MAX_UPLOAD_MB=5
UPLOAD_DIR=./storage
